<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS için: veri ve yedek dosyalarına tarayıcıdan doğrudan erişimi kapatır (Apache'deki .htaccess'in karşılığı).
     Veriye sadece kaydet.php üzerinden ulaşılır. -->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <fileExtensions>
          <add fileExtension=".json" allowed="false" />
          <add fileExtension=".lock" allowed="false" />
          <add fileExtension=".tmp" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>
